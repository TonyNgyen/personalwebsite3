generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id          Int           @id @default(autoincrement())
  title       String
  link        String        @unique
  createdAt   DateTime      @default(now())
  description String
  isPublished Boolean       @default(false)
  updatedAt   DateTime      @default(now()) @updatedAt
  sections    BlogContent[]
  tags        BlogTag[]
}

model Note {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  tags      NoteTag[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  emoji     String?
  bgColor   String
  textColor String
  blogs     BlogTag[]
  notes     NoteTag[]
}

model BlogTag {
  blogId Int
  tagId  Int
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model NoteTag {
  noteId Int
  tagId  Int
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model BlogContent {
  id        Int    @id @default(autoincrement())
  blogId    Int
  content   String
  sortOrder Int
  type      String
  blog      Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, sortOrder])
}
